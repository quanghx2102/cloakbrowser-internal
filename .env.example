# ============================================================
# CloakBrowser Manager — .env mẫu
# Sao chép file này thành .env và chỉnh sửa nếu cần
# ============================================================

# Port UI (mặc định 8080, chỉ bind localhost)
UI_PORT=8080

# Timezone container
TZ=Asia/Ho_Chi_Minh

# (Tuỳ chọn) Nếu cần log level
# LOG_LEVEL=info
