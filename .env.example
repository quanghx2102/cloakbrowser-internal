# ============================================================
# CloakBrowser Manager — .env.example (Desktop & Dev Mode Config)
# Sao chép file này thành .env để cấu hình local dev mode
# ============================================================

# --- Cấu hình Docker / Container (nếu còn sử dụng) ---
# Port UI (mặc định 8080)
UI_PORT=8080
# Timezone hệ thống
TZ=Asia/Ho_Chi_Minh

# --- Cấu hình Desktop / Local Development ---
# IP / Host của local FastAPI Backend
BACKEND_HOST=127.0.0.1
# Port chạy local backend API (dev mode quét hoặc bind port này)
BACKEND_PORT=8085

# Bật chế độ Desktop Mode (Tự khởi chạy backend cục bộ và gọi Chromium native)
DESKTOP_MODE=true

# Thư mục lưu trữ dữ liệu profiles, database, configs (mặc định tự tạo trong Application Support / AppData)
# Hãy để trống để sử dụng mặc định, hoặc nhập đường dẫn tuyệt đối khi phát triển
APP_DATA_DIR=

# --- Dev Overrides cho CloakBrowser Engine ---
# ĐƯỜNG DẪN đến binary hoặc symlink của CloakBrowser Engine.
# CHÚ Ý QUAN TRỌNG:
# 1. Các biến dưới đây CHỈ là DEV OVERRIDE (Dành cho nhà phát triển ghi đè nhanh chóng).
# 2. Ở phiên bản đóng gói release / end-user final: Người dùng KHÔNG cần cấu hình file .env.
#    App sẽ tự động auto-detect trong ~/.cloakbrowser hoặc cho phép chọn trực tiếp qua Settings Tab UI (lưu vào app-config.json).
CLOAKBROWSER_BINARY_PATH=
CLOAK_BROWSER_BINARY_PATH=

# Mức độ ghi log (debug, info, warning, error)
LOG_LEVEL=info
